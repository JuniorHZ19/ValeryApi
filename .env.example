# Copy to .env.local for local development, and set the same variables in Vercel → Settings → Environment Variables.

# Required. Long random string used to sign admin tokens (at least 32 characters).
JWT_SECRET=

# Required. Admin panel credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API (the Angular site).
CORS_ORIGINS=http://localhost:4318

# Required. PostgreSQL connection string.
# Local (after `npm run db:start`): postgres://valex:valex-local@localhost:5433/valex
# Vercel: created automatically when you add a Neon database to the project.
DATABASE_URL=postgres://valex:valex-local@localhost:5433/valex

# Optional locally, required on Vercel: created automatically when you add a Blob store to the project.
# Without it, uploaded images are stored in data/uploads (local development only).
BLOB_READ_WRITE_TOKEN=
